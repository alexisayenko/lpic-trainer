# Copy to .env on the server (never commit the real one).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lpic
DB_PASSWORD=your-db-password
DB_NAME=lpic

# Long random secret. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-token

# Local port Caddy proxies to.
PORT=8787

# Origins allowed to call the API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://lpic.isayenko.org,http://localhost:5173
